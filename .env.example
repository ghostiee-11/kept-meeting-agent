# Copy to backend/.env for local development. Never commit a filled-in copy.

# ---- Application -----------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# ---- API surface -----------------------------------------------------------
# Shared key required by write endpoints. Leave unset locally to disable auth.
# It MUST be set in production, and /health flags it when it is not.
DEMO_KEY=
CORS_ORIGINS=http://localhost:3000

# ---- Persistence -----------------------------------------------------------
# Neon connection strings, copied straight from `neon link`. Chosen over
# Render's free Postgres because that one self-destructs 30 days after creation
# and would break the demo link mid-review.
#
# Pooled for the app. Unpooled for migrations: pgbouncer in transaction mode
# does not support the prepared statements Alembic issues.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# ---- Model providers -------------------------------------------------------
# At least one is required. All three are free-tier friendly except OpenAI,
# which is only needed for the evaluation judge.
GROQ_API_KEY=
# A second Groq account, optional. If it is independently rate-limited from
# the first (check via the account dashboards, not assumed), the router
# alternates between them and roughly doubles both per-minute and daily
# throughput on the free tier.
GROQ_API_KEY_2=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---- Web search ------------------------------------------------------------
# Optional. Without it, search degrades to the keyless provider.
TAVILY_API_KEY=
MAX_SEARCHES_PER_RUN=4

# ---- Agent budgets ---------------------------------------------------------
MAX_MODEL_CALLS_PER_RUN=60
MAX_SUPERVISOR_STEPS=20

# ---- Mock task API ---------------------------------------------------------
# Raise the failure rate to watch retries and the circuit breaker do real work.
MOCK_FAILURE_RATE=0.0
MOCK_LATENCY_MS=0

# ---- Internal jobs ---------------------------------------------------------
# Guards POST /internal/sweep, which the nightly GitHub Actions cron calls.
INTERNAL_JOB_TOKEN=

# ---- Optional tracing ------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kept

# ---- Testing ---------------------------------------------------------------
# A real Postgres with pgvector. Locally this is a Neon branch (copy-on-write,
# so tests never touch development data). CI uses a service container.
# Unset means the database-backed tests skip rather than fail.
TEST_DATABASE_URL=
